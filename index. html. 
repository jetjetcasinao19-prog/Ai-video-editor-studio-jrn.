
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Video Editor Studio</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;background:#0b0e14;color:#fff;
 font-family:Arial,sans-serif;padding:16px
}
main{max-width:850px;margin:auto}
h1{font-size:25px;margin-bottom:4px}
.sub{color:#929bad;font-size:12px}
.panel{
 background:#151b27;border:1px solid #293449;
 padding:15px;border-radius:13px;margin:15px 0
}
label{display:block;margin-top:12px;font-size:13px;color:#c5ccda}
input,select,button{
 width:100%;padding:12px;margin-top:7px;
 border:1px solid #36435a;border-radius:8px;
 background:#0d1320;color:white;font-size:14px
}
button{
 background:#526dff;border:0;
 font-weight:bold;cursor:pointer
}
button:disabled{opacity:.45}
.secondary{background:#303b51}
canvas{
 width:100%;max-height:540px;
 object-fit:contain;background:#000;
 border-radius:10px;display:block
}
video{display:none}
.row{display:flex;gap:10px}
.row>*{flex:1;min-width:0}
.note{color:#9ba8bb;font-size:12px;line-height:1.6}
#status{color:#91b7ff;font-size:13px;margin-top:12px}
a{color:#9ab1ff;word-break:break-all}
</style>
</head>

<body>
<main>

<h1>VIDEO STUDIO</h1>
<div class="sub">AI MEDIA PRODUCTION • EDITING DEPARTMENT</div>

<section class="panel">
<h3>01 — Import Video</h3>
<input id="file" type="file" accept="video/*">
<p class="note">
Choose a video from your Android phone.
Processing happens inside your browser.
</p>
</section>

<section class="panel">
<h3>02 — Video Preview</h3>
<video id="video" playsinline preload="metadata"></video>
<canvas id="canvas" width="720" height="1280"></canvas>

<div class="row">
<button id="play" class="secondary" disabled>PLAY</button>
<button id="pause" class="secondary" disabled>PAUSE</button>
</div>

<p id="duration" class="note">No video loaded.</p>
</section>

<section class="panel">
<h3>03 — Editing Controls</h3>

<label>Video Format</label>
<select id="ratio">
<option value="9:16">Vertical 9:16 — Shorts/Reels</option>
<option value="16:9">Horizontal 16:9 — YouTube</option>
<option value="1:1">Square 1:1</option>
</select>

<label>Video Fit</label>
<select id="fit">
<option value="cover">Fill frame (crop edges)</option>
<option value="contain">Fit entire video</option>
</select>

<label>Start Time (seconds)</label>
<input id="start" type="number" min="0" step="0.1" value="0">

<label>End Time (seconds)</label>
<input id="end" type="number" min="0" step="0.1" value="0">

<label>Text Overlay</label>
<input id="overlay" maxlength="70"
placeholder="Enter your video title">

<label>Text Position</label>
<select id="position">
<option value="bottom">Bottom</option>
<option value="center">Center</option>
<option value="top">Top</option>
</select>

<label>Text Color</label>
<select id="color">
<option value="#ffffff">White</option>
<option value="#ffff00">Yellow</option>
<option value="#00e5ff">Cyan</option>
</select>

<button id="preview" class="secondary" disabled>
UPDATE PREVIEW
</button>
</section>

<section class="panel">
<h3>04 — Export Video</h3>
<p class="note">
Export your edited clip as a WebM video.
Keep the browser open during export.
</p>
<button id="export" disabled>EXPORT VIDEO</button>
<div id="status">Waiting for video...</div>
<div id="result"></div>
</section>

</main>

<script>
const $ = id => document.getElementById(id);

const video = $("video");
const canvas = $("canvas");
const ctx = canvas.getContext("2d");

let videoURL = null;
let exportURL = null;
let animationFrame = null;
let busy = false;

function dimensions(){
 const ratio = $("ratio").value;
 if(ratio === "9:16"){
  canvas.width=720;
  canvas.height=1280;
 }else if(ratio === "16:9"){
  canvas.width=1280;
  canvas.height=720;
 }else{
  canvas.width=1080;
  canvas.height=1080;
 }
}

function draw(){
 const w=canvas.width;
 const h=canvas.height;

 ctx.fillStyle="#000";
 ctx.fillRect(0,0,w,h);

 if(video.videoWidth && video.videoHeight){
  const vw=video.videoWidth;
  const vh=video.videoHeight;
  const fit=$("fit").value;

  const scale=fit==="cover"
   ?Math.max(w/vw,h/vh)
   :Math.min(w/vw,h/vh);

  const dw=vw*scale;
  const dh=vh*scale;

  ctx.drawImage(
   video,(w-dw)/2,(h-dh)/2,dw,dh
  );
 }

 const title=$("overlay").value.trim();

 if(title){
  const fontSize=Math.max(24,Math.round(w*0.055));
  const y=$("position").value==="top"
   ?h*0.15
   :$("position").value==="center"
   ?h*0.5:h*0.85;

  ctx.font="bold "+fontSize+"px Arial";
  ctx.textAlign="center";
  ctx.textBaseline="middle";
  ctx.lineWidth=fontSize*0.12;
  ctx.strokeStyle="#000";
  ctx.fillStyle=$("color").value;

  ctx.strokeText(title,w/2,y,w*0.88);
  ctx.fillText(title,w/2,y,w*0.88);
 }
}

function updatePreview(){
 dimensions();
 draw();
}

function stopAnimation(){
 if(animationFrame){
  cancelAnimationFrame(animationFrame);
  animationFrame=null;
 }
}

function animate(){
 draw();
 if(!video.paused && !video.ended){
  animationFrame=requestAnimationFrame(animate);
 }else{
  animationFrame=null;
 }
}

$("file").addEventListener("change",e=>{
 const file=e.target.files[0];
 if(!file)return;

 if(!file.type.startsWith("video/")){
  alert("Please select a video file.");
  return;
 }

 video.pause();

 if(videoURL) URL.revokeObjectURL(videoURL);

 videoURL=URL.createObjectURL(file);
 video.src=videoURL;

 $("status").textContent="Loading video...";
});

video.addEventListener("loadedmetadata",()=>{
 $("start").value=0;
 $("end").value=video.duration.toFixed(1);

 $("duration").textContent=
  "Duration: "+video.duration.toFixed(2)+" seconds";

 $("play").disabled=false;
 $("pause").disabled=false;
 $("preview").disabled=false;
 $("export").disabled=false;

 updatePreview();
 $("status").textContent="Video ready.";
});

$("play").addEventListener("click",async()=>{
 try{
  const end=Number($("end").value);
  if(video.currentTime>=end){
   video.currentTime=Number($("start").value);
  }
  await video.play();
  stopAnimation();
  animate();
 }catch(e){
  $("status").textContent="Unable to play video.";
 }
});

$("pause").addEventListener("click",()=>{
 video.pause();
 draw();
});

video.addEventListener("seeked",draw);
video.addEventListener("pause",()=>{
 stopAnimation();
 draw();
});

$("preview").addEventListener("click",updatePreview);

["ratio","fit","overlay","position","color"].forEach(id=>{
 $(id).addEventListener("change",updatePreview);
});

async function seek(time){
 return new Promise((resolve,reject)=>{
  if(Math.abs(video.currentTime-time)<0.02){
   resolve();
   return;
  }
  const timeout=setTimeout(()=>{
   reject(new Error("Video seek timed out."));
  },10000);
  video.addEventListener("seeked",()=>{
   clearTimeout(timeout);
   resolve();
  },{once:true});
  video.currentTime=time;
 });
}

$("export").addEventListener("click",async()=>{
 if(busy)return;

 const start=Number($("start").value);
 const end=Number($("end").value);

 if(!video.src || !Number.isFinite(video.duration)){
  alert("Import a video first.");
  return;
 }

 if(start<0 || end>video.duration || end<=start){
  alert("Please enter valid start and end times.");
  return;
 }

 if(!window.MediaRecorder ||
    !canvas.captureStream){
  alert("Your browser does not support video export.");
  return;
 }

 const mimeTypes=[
  "video/webm;codecs=vp9",
  "video/webm;codecs=vp8",
  "video/webm"
 ];

 const mimeType=mimeTypes.find(type=>
  MediaRecorder.isTypeSupported(type)
 );

 if(!mimeType){
  alert("WebM export is not supported.");
  return;
 }

 busy=true;
 $("export").disabled=true;
 $("status").textContent="Preparing export...";

 let recorder;
 let chunks=[];
 let canvasStream;
 let sourceStream;
 let finished=false;

 try{
  video.pause();
  stopAnimation();
  updatePreview();

  await seek(start);

  const tracks=[];

  canvasStream=canvas.captureStream(30);
  tracks.push(...canvasStream.getVideoTracks());

  if(typeof video.captureStream==="function"){
   sourceStream=video.captureStream();
   tracks.push(...sourceStream.getAudioTracks());
  }else{
   $("status").textContent=
    "Exporting without audio: browser audio capture unavailable.";
  }

  const output=new MediaStream(tracks);

  recorder=new MediaRecorder(output,{
   mimeType,
   videoBitsPerSecond:4000000
  });

  recorder.ondataavailable=e=>{
   if(e.data && e.data.size>0){
    chunks.push(e.data);
   }
  };

  const recording=new Promise((resolve,reject)=>{
   recorder.onstop=()=>resolve();
   recorder.onerror=()=>reject(
    new Error("Recording failed.")
   );
  });

  recorder.start(1000);

  await video.play();

  $("status").textContent="Recording video...";

  await new Promise((resolve,reject)=>{
   function frame(){
    draw();

    if(video.currentTime>=end || video.ended){
     video.pause();
     draw();
     resolve();
     return;
    }

    if(video.paused){
     reject(new Error("Playback stopped unexpectedly."));
     return;
    }

    requestAnimationFrame(frame);
   }

   requestAnimationFrame(frame);
  });

  if(recorder.state!=="inactive"){
   recorder.stop();
  }

  await recording;
  finished=true;

  const blob=new Blob(chunks,{type:mimeType});

  if(blob.size===0){
   throw new Error("Empty video export.");
  }

  if(exportURL) URL.revokeObjectURL(exportURL);
  exportURL=URL.createObjectURL(blob);

  const link=document.createElement("a");
  link.href=exportURL;
  link.download="edited-video.webm";
  link.textContent="DOWNLOAD YOUR VIDEO";

  $("result").replaceChildren(link);
  $("status").textContent=
   "Export completed! File size: "+
   (blob.size/1024/1024).toFixed(2)+" MB";

 }catch(error){
  if(recorder && recorder.state!=="inactive"){
   recorder.stop();
  }
  $("status").textContent="Export error: "+error.message;

 }finally{
  if(!finished && recorder && recorder.state!=="inactive"){
   try{recorder.stop()}catch(e){}
  }

  if(canvasStream){
   canvasStream.getTracks().forEach(t=>t.stop());
  }
  if(sourceStream){
   sourceStream.getTracks().forEach(t=>t.stop());
  }

  video.pause();
  draw();
  busy=false;
  $("export").disabled=false;
 }
});

window.addEventListener("beforeunload",()=>{
 if(videoURL)URL.revokeObjectURL(videoURL);
 if(exportURL)URL.revokeObjectURL(exportURL);
});
</script>
</body>
</html>
